# Editor settings shared by the team. Line endings are also enforced in Git by .gitattributes.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: PEP 8, matching the Ruff configuration in pyproject.toml.
[*.{py,pyi,toml}]
indent_size = 4

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

# Generated by uv; never edit by hand.
[uv.lock]
indent_style = unset
indent_size = unset

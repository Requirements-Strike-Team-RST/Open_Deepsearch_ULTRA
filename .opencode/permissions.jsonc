// OpenCode permission configuration for the four coding-agent roles (Plan, Test Author, Build, Verify).
// Specification: docs/architecture/permission-model.md (authoritative). This file is human-owned.
//
// Loading: OpenCode does not load .opencode/permissions.jsonc by name. The symlink
// .opencode/opencode.jsonc -> permissions.jsonc makes OpenCode load this file (verified on
// OpenCode 2.2.7). Edit this file only; never replace the symlink with a copy.
//
// Policy: routine work, including read-only web and documentation lookups, is allowed;
// risky but legitimate actions ask the human; only secrets, permission or approval
// tampering, force-pushes and role-separation breaches are denied. Within each object the last matching pattern wins, so every object lists its
// fallback first, then allows, then asks, then denies. "*" matches any characters, including
// "/" and spaces, so "*git push*" also matches inside a chain such as "x && git push".
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",

  // Approved MCP servers (listed in docs/code-governance/mcp-tool-manifest.md).
  // Context7: read-only library documentation. Optional higher rate limit: add
  // "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" } and set the variable.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },

  // Agents not defined below (built-in helpers, plugin agents) get nothing.
  "permission": {
    "*": "deny"
  },

  "agent": {
    "plan": {
      "description": "Plan role: software architecture. Drafts ASR, ADD entries, ADRs and module sections of the architecture and constraint documents. Never writes source or tests.",
      "mode": "primary",
      "permission": {
        "*": "ask",
        "question": "allow",
        "todowrite": "allow",
        "doom_loop": "ask",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "context7_*": "allow",
        "task": { "*": "deny", "explore": "allow" },
        "read": {
          "*": "allow",
          "*.env*": "deny",
          "*.env.example": "allow",
          ".git/*": "deny"
        },
        "edit": {
          "*": "allow",
          "AGENTS.md": "ask",
          "Prompt.md": "ask",
          ".agent/*": "ask",
          ".github/*": "ask",
          "pyproject.toml": "ask",
          "uv.lock": "ask",
          "docs/req/*": "ask",
          "docs/architecture/permission-model.md": "ask",
          "docs/code-governance/mcp-tool-manifest.md": "ask",
          "docs/ai-use-log.yaml": "ask",
          "docs/review-memo.md": "ask",
          "docs/bug-diary.md": "ask",
          "docs/debt-register.md": "ask",
          "docs/architecture/adr/000-template.md": "deny",
          "src/*": "deny",
          "test/*": "deny",
          "scripts/*": "deny",
          ".opencode/*": "deny",
          "opencode.json*": "deny",
          "docs/approvals/*": "deny",
          "*.env*": "deny"
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "tree*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git blame*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "uv sync*": "allow",
          "uv run pytest*": "allow",
          "uv run python -m pytest*": "allow",
          "uv run ruff check*": "allow",
          "uv run mypy*": "allow",
          "uv run python scripts/validate_requirements.py*": "allow",
          "*>*": "ask",
          "*rm *": "ask",
          "*git push*": "ask",
          "*git reset*": "ask",
          "*git rebase*": "ask",
          "*git checkout*": "ask",
          "*git stash*": "ask",
          "*uv add*": "ask",
          "*uv remove*": "ask",
          "*pip install*": "ask",
          "*curl *": "ask",
          "*wget *": "ask",
          "*push --force*": "deny",
          "*push -f*": "deny",
          "*sudo *": "deny",
          "*.env*": "deny",
          "*.opencode*": "deny",
          "*opencode.json*": "deny",
          "*docs/approvals*": "deny"
        }
      }
    },

    "test-author": {
      "description": "Test Author role: after Gate 1, writes the tests in the approved test plan, confirms they fail on the baseline and records the baseline run. Never changes source code.",
      "mode": "primary",
      "permission": {
        "*": "ask",
        "question": "allow",
        "todowrite": "allow",
        "doom_loop": "ask",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "context7_*": "allow",
        "task": { "*": "deny", "explore": "allow" },
        "read": {
          "*": "allow",
          "*.env*": "deny",
          "*.env.example": "allow",
          ".git/*": "deny"
        },
        "edit": {
          "*": "allow",
          "AGENTS.md": "ask",
          "Prompt.md": "ask",
          ".agent/*": "ask",
          ".github/*": "ask",
          "pyproject.toml": "ask",
          "uv.lock": "ask",
          "docs/req/*": "ask",
          "docs/code-governance/*": "ask",
          "docs/architecture/*": "ask",
          "docs/ai-use-log.yaml": "ask",
          "docs/review-memo.md": "ask",
          "docs/bug-diary.md": "ask",
          "docs/debt-register.md": "ask",
          "src/*": "deny",
          "scripts/*": "deny",
          "test/*": "deny",
          "test/offline/*": "allow",
          "test/live/*": "allow",
          ".opencode/*": "deny",
          "opencode.json*": "deny",
          "docs/approvals/*": "deny",
          "*.env*": "deny"
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "tree*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git blame*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git switch*": "allow",
          "uv sync*": "allow",
          "uv run pytest*": "allow",
          "uv run python -m pytest*": "allow",
          "uv run ruff check*": "allow",
          "uv run ruff format test/offline*": "allow",
          "uv run ruff format test/live*": "allow",
          "uv run mypy*": "allow",
          "uv run python scripts/validate_requirements.py*": "allow",
          "*>*": "ask",
          "*rm *": "ask",
          "*git push*": "ask",
          "*git reset*": "ask",
          "*git rebase*": "ask",
          "*git checkout*": "ask",
          "*git stash*": "ask",
          "*uv add*": "ask",
          "*uv remove*": "ask",
          "*pip install*": "ask",
          "*curl *": "ask",
          "*wget *": "ask",
          "*push --force*": "deny",
          "*push -f*": "deny",
          "*sudo *": "deny",
          "*.env*": "deny",
          "*.opencode*": "deny",
          "*opencode.json*": "deny",
          "*docs/approvals*": "deny"
        }
      }
    },

    "build": {
      "description": "Build role: after Gate 2, implements the code until the approved tests pass, runs the checks and writes a build report. Never changes tests.",
      "mode": "primary",
      "permission": {
        "*": "ask",
        "question": "allow",
        "todowrite": "allow",
        "doom_loop": "ask",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "context7_*": "allow",
        "task": { "*": "deny", "explore": "allow" },
        "read": {
          "*": "allow",
          "*.env*": "deny",
          "*.env.example": "allow",
          ".git/*": "deny"
        },
        "edit": {
          "*": "allow",
          "AGENTS.md": "ask",
          "Prompt.md": "ask",
          ".agent/*": "ask",
          ".github/*": "ask",
          "pyproject.toml": "ask",
          "uv.lock": "ask",
          "docs/req/*": "ask",
          "docs/code-governance/*": "ask",
          "docs/architecture/*": "ask",
          "docs/ai-use-log.yaml": "ask",
          "docs/review-memo.md": "ask",
          "docs/bug-diary.md": "ask",
          "docs/debt-register.md": "ask",
          "test/offline/*": "deny",
          "test/live/*": "deny",
          ".opencode/*": "deny",
          "opencode.json*": "deny",
          "docs/approvals/*": "deny",
          "*.env*": "deny"
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "tree*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git blame*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git switch*": "allow",
          "uv sync*": "allow",
          "uv run pytest*": "allow",
          "uv run python -m pytest*": "allow",
          "uv run ruff check*": "allow",
          "uv run ruff format src*": "allow",
          "uv run mypy*": "allow",
          "uv run python scripts/validate_requirements.py*": "allow",
          "*>*": "ask",
          "*rm *": "ask",
          "*git push*": "ask",
          "*git reset*": "ask",
          "*git rebase*": "ask",
          "*git checkout*": "ask",
          "*git stash*": "ask",
          "*uv add*": "ask",
          "*uv remove*": "ask",
          "*pip install*": "ask",
          "*curl *": "ask",
          "*wget *": "ask",
          "*push --force*": "deny",
          "*push -f*": "deny",
          "*sudo *": "deny",
          "*.env*": "deny",
          "*.opencode*": "deny",
          "*opencode.json*": "deny",
          "*docs/approvals*": "deny"
        }
      }
    },

    "verify": {
      "description": "Verify role: after Build, independently runs the approved tests and all prior suites against the fit criterion, writes and commits the verification report. Never edits source, tests or thresholds.",
      "mode": "primary",
      "permission": {
        "*": "ask",
        "question": "allow",
        "todowrite": "allow",
        "doom_loop": "ask",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "context7_*": "allow",
        "task": { "*": "deny", "explore": "allow" },
        "read": {
          "*": "allow",
          "*.env*": "deny",
          "*.env.example": "allow",
          ".git/*": "deny"
        },
        "edit": {
          "*": "allow",
          "AGENTS.md": "ask",
          "Prompt.md": "ask",
          ".agent/*": "ask",
          ".github/*": "ask",
          "pyproject.toml": "ask",
          "uv.lock": "ask",
          "docs/req/*": "ask",
          "docs/code-governance/*": "ask",
          "docs/architecture/*": "ask",
          "docs/ai-use-log.yaml": "ask",
          "docs/review-memo.md": "ask",
          "docs/bug-diary.md": "ask",
          "docs/debt-register.md": "ask",
          "src/*": "deny",
          "test/*": "deny",
          "scripts/*": "deny",
          ".opencode/*": "deny",
          "opencode.json*": "deny",
          "docs/approvals/*": "deny",
          "*.env*": "deny"
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "tree*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git blame*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "uv sync*": "allow",
          "uv run pytest*": "allow",
          "uv run python -m pytest*": "allow",
          "uv run ruff check*": "allow",
          "uv run mypy*": "allow",
          "uv run python scripts/validate_requirements.py*": "allow",
          "*>*": "ask",
          "*rm *": "ask",
          "*sed -i*": "ask",
          "*ruff format*": "ask",
          "*git push*": "ask",
          "*git reset*": "ask",
          "*git rebase*": "ask",
          "*git checkout*": "ask",
          "*git stash*": "ask",
          "*uv add*": "ask",
          "*uv remove*": "ask",
          "*pip install*": "ask",
          "*curl *": "ask",
          "*wget *": "ask",
          "*push --force*": "deny",
          "*push -f*": "deny",
          "*sudo *": "deny",
          "*.env*": "deny",
          "*.opencode*": "deny",
          "*opencode.json*": "deny",
          "*docs/approvals*": "deny"
        }
      }
    },

    // Read-only search sub-agent that every role may delegate to.
    "explore": {
      "permission": {
        "*": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "read": {
          "*": "allow",
          "*.env*": "deny",
          "*.env.example": "allow",
          ".git/*": "deny"
        }
      }
    }
  }
}
